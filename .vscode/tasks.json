{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Generals Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Generals-Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Generals Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Generals-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Zero Hour Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "ZeroHour-Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Zero Hour Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "ZeroHour-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
